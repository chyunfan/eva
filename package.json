{
  "name": "department-evaluation",
  "version": "1.0.0",
  "private": true,
  "description": "部门季度评价系统 - Vue3 前端 + Node.js 后端，支持外网 Supabase / 内网 DB2 双部署，可挂企业微信获取姓名与柜员号。评分主页(index.html)位于项目根目录。",
  "scripts": {
    "start": "node server/index.js",
    "dev:server": "node server/index.js",
    "dev": "vite",
    "build": "vite build",
    "build:eva": "VITE_BASE=/eva/ vite build",
    "preview": "vite preview",
    "dev:all": "vite & node server/index.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.9",
    "express": "^4.22.2",
    "vue": "^3.4.0"
  },
  "optionalDependencies": {
    "ibm_db": "^3.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "vite": "^5.2.0"
  }
}
